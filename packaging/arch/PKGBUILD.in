pkgname=echofiles
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native Linux file manager with fast indexed search'
arch=('x86_64')
url='https://github.com/adityavardhansharma/EchoFiles_Linux'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'vulkan-icd-loader')
makedepends=('rust' 'pkgconf')
optdepends=('udisks2: mount and manage drives' 'polkit: authenticate privileged drive operations' 'xdg-utils: open files in other applications')
source=("echofiles-$pkgver-source.tar.gz")
sha256sums=('@SHA256@')
options=('!lto')

prepare() {
  cd "echofiles-$pkgver"
  cargo fetch --locked
}

build() {
  cd "echofiles-$pkgver"
  # Release binaries must run on baseline x86-64, not only the maintainer's AVX2 CPU.
  export RUSTFLAGS='-C target-cpu=x86-64'
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p echofiles -p echofiles-index --bin echofiles --bin ef
}

package() {
  cd "echofiles-$pkgver"
  install -Dm755 "$srcdir/target/release/echofiles" "$pkgdir/usr/bin/echofiles"
  install -Dm755 "$srcdir/target/release/ef" "$pkgdir/usr/bin/ef"
  install -Dm644 packaging/echofiles.desktop "$pkgdir/usr/share/applications/echofiles.desktop"
  install -Dm644 assets/brand/echofiles-logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/echofiles.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/echofiles/README.md"
}
