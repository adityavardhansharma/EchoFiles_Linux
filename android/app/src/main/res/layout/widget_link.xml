<?xml version="1.0" encoding="utf-8"?>
<!-- The Relay widget: carbon (the laptop) over the seam over paper (this phone). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121211"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_led"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_led" />

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:text="LINKED"
                android:textColor="#BEBAB0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans"
                android:singleLine="true"
                android:text="EchoConnect"
                android:textColor="#F2EFE8"
                android:textFontWeight="600"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:text="--"
                android:textColor="#F2EFE8"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="#121211">

        <ImageView
            android:id="@+id/widget_seam"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_seam" />

        <ImageView
            android:id="@+id/widget_flat"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:background="#2D2D2A"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2DDD3"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_files"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_signal"
            android:contentDescription="Send files to the laptop"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="FILES ↑"
            android:textColor="#160700"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_clip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_paper"
            android:contentDescription="Send the clipboard to the laptop"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="CLIP ↑"
            android:textColor="#161512"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
